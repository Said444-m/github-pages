<header>
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Приколы для Ярика</title>
    <style>
        body {
            font-family: 'Comic Sans MS', cursive, sans-serif;
            background-color: #ffeb3b;
            text-align: center;
            margin: 0;
            padding: 20px;
            transition: background-color 0.5s;
        }
        
        .container {
            max-width: 800px;
            margin: 0 auto;
            background-color: white;
            padding: 20px;
            border-radius: 15px;
            box-shadow: 0 0 20px rgba(0,0,0,0.2);
        }
        
        h1 {
            color: #e91e63;
            font-size: 2.5em;
            text-shadow: 2px 2px 4px #ccc;
        }
        
        .joke {
            margin: 30px 0;
            padding: 15px;
            border: 2px dashed #4caf50;
            border-radius: 10px;
            background-color: #e8f5e9;
            cursor: pointer;
            transition: transform 0.3s;
        }
        
        .joke:hover {
            transform: scale(1.03);
        }
        
        button {
            background-color: #4caf50;
            color: white;
            border: none;
            padding: 10px 20px;
            font-size: 16px;
            cursor: pointer;
            border-radius: 5px;
            margin: 10px;
            transition: all 0.3s;
        }
        
        button:hover {
            background-color: #2e7d32;
            transform: scale(1.1);
        }
        
        #surprise {
            display: none;
            margin-top: 20px;
            font-size: 24px;
            color: #e91e63;
            font-weight: bold;
        }
        
        .yarik-img {
            width: 150px;
            height: 150px;
            object-fit: cover;
            border-radius: 50%;
            border: 5px solid #e91e63;
            margin: 20px;
            transition: all 0.5s;
        }
        
        .yarik-img:hover {
            transform: rotate(360deg);
        }
        
        .rainbow-text {
            background-image: linear-gradient(to left, violet, indigo, blue, green, yellow, orange, red);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            animation: rainbow 2s linear infinite;
        }
        
        @keyframes rainbow {
            0% {background-position: 0% 50%;}
            100% {background-position: 100% 50%;}
        }
    </style>
</head>
<body>
    <div class="container">
        <img src="https://i.imgur.com/dZ8Q6zO.png" alt="Ярик" class="yarik-img" id="yarikPhoto">
        <h1 class="rainbow-text">Приколы для <span id="name">Ярика</span>!</h1>
        
        <div class="joke" onclick="this.innerHTML = 'Потому что он Ярик! Ха-ха!'">
            Почему Ярик переходит дорогу? <br><small>(нажми, чтобы узнать ответ)</small>
        </div>
        
        <div class="joke" onclick="this.innerHTML = 'Чтобы проверить, не украл ли Ярик его носки!'">
            Зачем программист ходит в гости к Ярику? <br><small>(нажми, чтобы узнать ответ)</small>
        </div>
        
        <div class="joke" onclick="this.innerHTML = 'Потому что Ярик уже съел все нормальные!'">
            Почему в магазине остались только кривые огурцы? <br><small>(нажми, чтобы узнать ответ)</small>
        </div>
        
        <button onclick="showSurprise()">Нажми для сюрприза!</button>
        <div id="surprise"></div>
        
        <button onclick="changeBackground()">Сменить цвет фона</button>
        
        <button onclick="danceYarik()">Заставь Ярика танцевать!</button>
    </div>
    
    <script>
        function showSurprise() {
            const surprises = [
                "Ярик, ты самый лучший!",
                "Ярик - король приколов!",
                "Кто тут у нас? Да это же Ярик!",
                "Ярик, не вешай нос!",
                "Ты знал, что Ярик - самое крутое имя?"
            ];
            const randomSurprise = surprises[Math.floor(Math.random() * surprises.length)];
            document.getElementById('surprise').style.display = 'block';
            document.getElementById('surprise').textContent = randomSurprise;
            
            // Анимация
            setTimeout(() => {
                document.getElementById('surprise').style.fontSize = '40px';
                document.getElementById('surprise').style.color = '#ff5722';
            }, 100);
            
            setTimeout(() => {
                document.getElementById('surprise').style.fontSize = '24px';
                document.getElementById('surprise').style.color = '#e91e63';
            }, 1000);
        }
        
        function changeBackground() {
            const colors = ['#ffeb3b', '#b3e5fc', '#d1c4e9', '#c8e6c9', '#ffccbc'];
            const randomColor = colors[Math.floor(Math.random() * colors.length)];
            document.body.style.backgroundColor = randomColor;
        }
        
        function danceYarik() {
            const yarik = document.getElementById('yarikPhoto');
            yarik.style.animation = 'dance 0.5s infinite';
            
            setTimeout(() => {
                yarik.style.animation = 'none';
            }, 3000);
        }
        
        // Добавляем стили для танца
        const style = document.createElement('style');
        style.innerHTML = `
            @keyframes dance {
                0%, 100% { transform: rotate(0deg) scale(1); }
                25% { transform: rotate(10deg) scale(1.1); }
                50% { transform: rotate(-10deg) scale(1.2); }
                75% { transform: rotate(10deg) scale(1.1); }
            }
        `;
        document.head.appendChild(style);
        
        // Меняем имя при клике
        document.getElementById('name').addEventListener('click', function() {
            const names = ['Ярик', 'Ярослав', 'Яричек', 'Ярикус', 'Ярикандр'];
            this.textContent = names[Math.floor(Math.random() * names.length)];
        });
    </script>
</body>
</html>
